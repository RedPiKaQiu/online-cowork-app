# Local development reaches the remote PostgreSQL instance through an SSH tunnel.
# Do not commit .env.local or any real database credentials.
DATABASE_URL=postgresql://cowork:replace-with-password@127.0.0.1:5432/cowork_dev

# Required for hashing secure project access links.
PROJECT_TOKEN_PEPPER=replace-with-a-long-random-secret

# Single-administrator configuration. Generate ADMIN_PASSWORD_HASH with
# `pnpm admin:hash-password "your-password"` and SESSION_SECRET with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:replace-with-generated-salt:replace-with-generated-hash
SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
