# Copy to .env.production and replace every placeholder. Never commit real values.
POSTGRES_DB=cowork_prod
POSTGRES_USER=cowork
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://cowork:replace-with-url-encoded-password@postgres:5432/cowork_prod
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:replace-with-generated-salt:replace-with-generated-hash
SESSION_SECRET=replace-with-a-random-base64url-secret-at-least-32-bytes
PROJECT_TOKEN_PEPPER=replace-with-a-long-random-secret
APP_URL=https://your-domain.example.com
APP_RELEASE=replace-with-git-sha-or-release-version
NODE_ENV=production
