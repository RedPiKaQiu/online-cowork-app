# Copy this file to .env.production. Do not commit .env.production.
#
# The defaults below are for local/intranet trials only. Before exposing the
# service or storing real data, replace the trial password, admin account and
# all secrets with unique random values.

# PostgreSQL settings. DATABASE_URL must use the same user, password and
# database name. URL-encode the password in DATABASE_URL if it contains @, :, /,
# ?, #, %, $ or spaces.
POSTGRES_DB=cowork_trial
POSTGRES_USER=cowork
POSTGRES_PASSWORD=cowork_trial_password
DATABASE_URL=postgresql://cowork:cowork_trial_password@postgres:5432/cowork_trial

# Trial administrator: trial@example.com / try-cowork-2026
# Generate a production hash with:
# npx --yes pnpm@10.32.1 admin:hash-password 'your-admin-password'
ADMIN_EMAIL=trial@example.com
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:dHJpYWwtYWRtaW4tc2FsdA:NLTDHeiInnsGSq5rEzGrw4teDSpc3ZDxLqaw8EUEZyaZPbX3U0bLoaBkMe-sc2TxEhxy9Rbcv3alqrNPz685og

# Required secrets. Generate each production value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing SESSION_SECRET signs out all administrators; changing
# PROJECT_TOKEN_PEPPER invalidates existing project access links.
SESSION_SECRET=trial-session-secret-change-before-public-use
PROJECT_TOKEN_PEPPER=trial-project-token-pepper-change-before-public-use

# Default to the server's loopback (internal) address for trial. To let other
# intranet devices open links, change this to its LAN IP, e.g.
# http://192.168.1.20:3000. If an external gateway is configured separately,
# set its final access URL here.
APP_URL=http://127.0.0.1:3000

# APP_RELEASE is optional but useful for troubleshooting; NODE_ENV stays fixed.
APP_RELEASE=trial
NODE_ENV=production
